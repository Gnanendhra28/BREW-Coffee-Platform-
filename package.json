{
  "name": "brew-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=1536' next build --webpack",
    "postbuild": "node -e \"const fs = require('fs'); if (fs.existsSync('.next/standalone')) { fs.cpSync('public', '.next/standalone/public', { recursive: true }); fs.cpSync('.next/static', '.next/standalone/.next/static', { recursive: true }); }\"",
    "start": "next start",
    "start:standalone": "HOSTNAME=0.0.0.0 node --max-old-space-size=450 .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verify-all.mjs",
    "test:p49": "node scripts/verify-phase4-9-order-lifecycle.mjs",
    "test:p50": "npx tsx scripts/verify-phase5-0-ai-agents.ts",
    "test:p51": "node scripts/verify-phase5-1-razorpay-lifecycle.mjs",
    "test:e2e": "playwright test",
    "deploy:gcp": "./scripts/deploy-gcp.sh"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "three": "^0.186.0",
    "typescript": "^5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0"
  }
}
